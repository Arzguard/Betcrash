{
  "rewrites": [
    { "source": "/admin",      "destination": "/Betcrash/betcrash-admin.html" },
    { "source": "/kyc",        "destination": "/betcrash-admin-kyc.html" },
    { "source": "/onboarding", "destination": "/betcrash-onboarding.html" },
    { "source": "/wallet",     "destination": "/Betcrash/betcrash-wallet_1.html" },
    { "source": "/game",       "destination": "/index.html" }
  ],
  "redirects": [
    { "source": "/Betcrash/betcrash-live.html", "destination": "/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/favicon/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
